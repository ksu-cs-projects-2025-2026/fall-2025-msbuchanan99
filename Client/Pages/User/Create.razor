@page "/CreateAccount"

@inject UserService userService
@inject UserState userState
@inject NavigationManager Nav

<h3>Create Account</h3>
<EditForm Model="@userState.Draft" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label class="form-label">Username</label>
        <InputText class="form-control w-25" @bind-Value="userState.Draft.Username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText class="form-control w-25" type="password" @bind-Value="userState.Draft.Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Confirm Password</label>
        <InputText class="form-control w-25" type="password" @bind-Value="userState.Draft.ConfirmPassword" />
    </div>
    <div class="mb-3">
        <label class="form-label">Settings</label>
        @*TODO: Add Settings*@
    </div>
    <button class="btn btn-primary" type="submit" disabled="@busy" @onclick="Submit">
        @(busy ? "Creating..." : "Create Account")
    </button>
    @if (!string.IsNullOrEmpty(userState.LastError))
    {
        <div class="text-danger mt-2">@userState.LastError</div>
    }
</EditForm>

    @code {
    private bool busy = false;
    private Result? result;

    private async Task Submit()
    {
        busy = true;

        result = await userService.CreateUserAsync();
        if (result.Ok) { }
        else { }

        busy = false;
    }
}
