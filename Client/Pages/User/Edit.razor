@page "/user/profile/edit"

@using Client.Models
@using Client.Services

@inject UserService userService
@inject NavigationManager Nav

<h3>Edit Profile</h3>

<EditForm Model="@user">
    <DataAnnotationsValidator/>
    <ValidationSummary />
    <div class="mb-3">
        <label class="form-label">Username: </label>
        <InputText class="form-control w-25" @bind-Value="user.Username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password: </label>
        <InputText class="form-control w-25" type="password" @bind-Value="user.Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Confirm Password: </label>
        <InputText class="form-control w-25" type="password" @bind-Value="user.ConfirmPassword" />
    </div>
    @* TODO: User Settings*@
    <button class="btn btn-primary" type="submit" disabled="@busy" @onclick="Save">
        @(busy ? "Saving..." : "Save")
    </button>
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="text-danger mt-2">@error</div>
    }
</EditForm>

    @code {
    private UserModel? user;
    private bool busy;
    private string? error;

    //Load in existing information
    protected override async Task OnInitializedAsync()
    {
        await userService.UserLoadedAsync();

        if (userService.CurrentUser is not null)
        {
            error = null;
            user = new UserModel
            {
                Username = userService.CurrentUser.Username
            };
        }
        else
        {
            user = null;
            error = "Error finding user information.";
        }
    }

    public async Task Save()
    {
        busy = true;
        error = null;

        error = await userService.UpdateUserAsync(user);

        //redirect maybe
        if (error is null) Nav.NavigateTo("/user/profile");

        busy = false;
    }
}
