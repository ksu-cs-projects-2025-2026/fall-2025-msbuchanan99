@page "/user/profile/edit"

@inject UserService userService
@inject UserState userState
@inject NavigationManager Nav

@if (userState.IsLoading)
{
    <h3>Loading...</h3>
}
else if(userState.User is null)
{
    <UnAuthorized></UnAuthorized>
}
else
{
    <h3>Edit Profile</h3>

    <EditForm Model="@userState.Draft">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label">Username: </label>
            <InputText class="form-control w-25" @bind-Value="userState.Draft.Username" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password: </label>
            <InputText class="form-control w-25" type="password" @bind-Value="userState.Draft.Password" />
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm Password: </label>
            <InputText class="form-control w-25" type="password" @bind-Value="userState.Draft.ConfirmPassword" />
        </div>
        @* TODO: User Settings*@
        <button class="btn btn-primary" type="submit" disabled="@busy" @onclick="Save">
            @(busy ? "Saving..." : "Save")
        </button>
        <button class="btn btn-secondary" type="submit" disabled="@busy" @onclick="Cancel">Cancel</button>
        @if (!string.IsNullOrEmpty(userState.LastError))
        {
            <div class="text-danger mt-2">@userState.LastError</div>
        }
    </EditForm>
}

@code {
    private bool busy;
    private Result? result;

    //Load in existing information
    protected override async Task OnInitializedAsync()
    {
        await userService.UserLoadedAsync();
    }

    public async Task Save()
    {
        busy = true;

        result = await userService.UpdateUserAsync();
        if (result.Ok)
        {
            Nav.NavigateTo("/user/profile");
        }
        else
        {

        }

        busy = false;
    }

    public void Cancel()
    {
        busy = true;

        userService.CancelUpdate();
        Nav.NavigateTo("/user/profile");

        busy = false;
    }
}
