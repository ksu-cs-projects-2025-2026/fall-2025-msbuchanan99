@page "/"

@using Client.Services
@using Client.Models

@inject HttpClient Http
@inject UserService userService

<PageTitle>Home</PageTitle>

@if (isLoading)
{
    <h1>Loading...</h1>
}
else if(userService.CurrentUser is not null)
{
    <h1>Welcome to Threadfolio, @userService.CurrentUser.Username</h1>
    <p>
        Welcome to Threadfolio - a place to manage your cross stitch projects.
    </p>
    <p>
        This will become the home of Threadfolio's social feed in a future update.
    </p>
}
else
{
    <h1>Welcome to Threadfolio. Please log in.</h1>
}

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Re-render when the shared user changes
        userService.UserChanged += OnAuthChanged;

        isLoading = true;
        await userService.UserLoadedAsync(); // centralizes /api/auth/me fetch & sets CurrentUser
        isLoading = false;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        userService.UserChanged -= OnAuthChanged;
    }
}