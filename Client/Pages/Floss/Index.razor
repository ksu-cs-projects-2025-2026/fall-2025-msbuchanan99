@page "/user/floss"

@inject UserState userState
@inject UserService userService
@inject FlossState flossState
@inject FlossService flossService

<h2>My Floss</h2>
@if (userState.IsLoading || flossState.IsLoading)
{
    
}
else if(userState.User is null)
{
    <UnAuthorized/>
}
else
{
    <div class="d-flex flex-row justify-content-between">
        @*Filters*@
        <div class="d-flex flex-column flex-grow-0 border-2 border-secondary">
            <h3>Search</h3>
            <div class="pt-2">
                <InputText @bind-Value="SearchText" ></InputText>
            </div>
            <div>
                <InputRadioGroup @bind-Value="Owned">
                    <div class="form-check">
                        <InputRadio class="form-check-input" Value="OwnershipMode.Owned"/>
                        <label class="form-check-label">Owned Floss</label>
                    </div>
                    <div class="form-check">
                        <InputRadio class="form-check-input" Value="OwnershipMode.Unowned" />
                        <label class="form-check-label">Unowned Floss</label>
                    </div>
                    <div class="form-check">
                        <InputRadio class="form-check-input" Value="OwnershipMode.Both" />
                        <label class="form-check-label">All Floss</label>
                    </div>
                </InputRadioGroup>
            </div>
            <button type="button" class="btn btn-primary mt-auto align-self-center" @onclick="SearchFloss">Search</button>
        </div>

        @*FlossList*@
        <div class="d-flex flex-grow-1">
            <UserFlossList floss="flossState.UserFlossFiltered" OnSelected="StartEditFloss"></UserFlossList>
        </div>
    </div>

    @*Confirmation Modal*@
    <ConfirmationModal Message="@Message" NumberRequired="NumberRequired" OnConfirm="(i) => ConfirmEdit((int)i)" OnDeny="DenyEdit"></ConfirmationModal>
}


@code{
    private bool busy = false;
    private string SearchText = "";
    private OwnershipMode Owned = OwnershipMode.Owned;

    private string? Message;
    private int? selectedId;
    private bool NumberRequired;

    protected override async Task OnInitializedAsync()
    {
        userState.Changed += OnUserStateChanged;
        flossState.Changed += OnFlossStateChanged;

        await userService.UserLoadedAsync();
        if(userState.User is not null)
        {
            _ = await flossService.LoadFlosses();
            _ = await flossService.LoadUserFlosses(userState.User.Id);
        }
    }

    private void OnUserStateChanged() => InvokeAsync(StateHasChanged);
    private void OnFlossStateChanged() => InvokeAsync(StateHasChanged); 
    public void Dispose()
    {
        userState.Changed -= OnUserStateChanged;
        flossState.Changed -= OnFlossStateChanged;
    }

    public void SearchFloss()
    {
        busy = true;

        flossService.FilterUserFlosses(SearchText, Owned);

        busy = false;
    }

    public void StartEditFloss(UserFlossModel floss)
    {
        busy = true;

        selectedId = floss.Id;
        NumberRequired = true;
        Message = $"How many skeins of number {floss.Name} do you have? Round up to the nearest whole number.";

        busy = false;
    }

    public async Task ConfirmEdit(int? amount)
    {
        busy = true;

        Result result = await flossService.EditFloss(userState.User.Id, selectedId, amount);

        if (result.Ok)
        {
            Message = null;
            selectedId = null;
        }
        else
        {
            Message = null;
        }

        busy = false;
    }

    public void DenyEdit()
    {
        busy = true;

        Message = null;
        selectedId = null;

        busy = false;
    }
}