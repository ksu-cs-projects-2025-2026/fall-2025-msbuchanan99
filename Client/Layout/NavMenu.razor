@inject HttpClient Http
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @if (isLoggedIn && user!.role == "User") //User
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/user/projects">
                    <span class="bi bi-palette2-nav-menu" aria-hidden="true"></span> My Projects
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/logout">
                    <span class="bi bi-door-open-fill-nav-menu" aria-hidden="true"></span> Log Out
                </NavLink>
            </div>
        }
        else if (isLoggedIn && user!.role == "Admin") //Admin
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/logout">
                    <span class="bi bi-door-open-fill-nav-menu" aria-hidden="true"></span> Log Out
                </NavLink>
            </div>
        }
        else if (!isLoggedIn) //Anonymous
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">
                    <span class="bi bi-door-open-nav-menu" aria-hidden="true"></span> Log In
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool isLoggedIn = false;
    private User? user;
    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage response = await Http.GetAsync("/api/auth/me");
        await JS.InvokeVoidAsync("console.log", response.StatusCode);
        if (response.IsSuccessStatusCode)
        {
            isLoggedIn = true;
            await JS.InvokeVoidAsync("console.log", "meow");
            user = await response.Content.ReadFromJsonAsync<User>();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await JS.InvokeVoidAsync("console.log", "meow meow");
            isLoggedIn = false;
            user = null;
        }
    }


    public class User
    {
        public string? username{ get; set; }
        public string? role { get; set; }
    }
}
