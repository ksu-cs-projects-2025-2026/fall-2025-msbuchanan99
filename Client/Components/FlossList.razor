@if(floss is null)
{
    <div class="text-muted">Loading...</div>
}
else
{
    <div class="d-flex flex-row">
        @*Header Row*@
        <div class="w-10">Color</div>
        <div class="w-20">Number</div>
        <div class="w-40">Name</div>
        <div class="w-15"># Strands</div>
        <div class="w-15"># Skeins</div>
    </div>
    @foreach (FlossInProjectModel f in floss)
    {
        <div class="d-flex flex-row select-row @(selected == f ? "selected" : "")" @onclick="() => SelectRow(f)">
            @*Symbol & HexColor in a cube*@
            <div class="w-10">
                <div class="symbol-cube" style=@($"background-color: #{f.HexColor}")></div>
            </div>

            @*Number*@
            <div class="w-20">
                @f.Number
            </div>

            @*Name*@
            <div class="w-50">
                @f.Name
            </div>

            @*Strands*@
            <div class="w-10">
                @f.Strands
            </div>

            @*Amount Needed*@
            <div class="w-10">
                @f.Amount
            </div>
        </div>
    }
}

@code{
    [Parameter] public IReadOnlyList<FlossInProjectModel>? floss { get; set; }
    [Parameter] public EventCallback<FlossInProjectModel> OnSelected { get; set; }
    private FlossInProjectModel? selected;

    private async Task SelectRow(FlossInProjectModel f)
    {
        if(selected is not null && f.Id == selected.Id)
        {
            selected = null;
        }
        else
        {
            selected = f;
        }
        await OnSelected.InvokeAsync(f);
    }
}

<style>
    .w-10{
        width: 10%;
    }
    .w-15 {
        width: 15%;
    }
    .w-40 {
        width: 40%;
    }
    .w-20{
        width: 20%;
    }
    .symbol-cube{
        width: 20px;
        height: 20px;
        border: #262626 solid 2px;
        text-align: center;
    }

    .space-between {
        justify-content: space-between
    }

    .select-row {
        cursor: pointer;
        padding: 4px 0;
        transition: background-color 0.15s ease-in-out;
    }
    .select-row:hover{
        background-color: #c2c2c2;
    }
    .selected{
        background-color: #c6c6c0;
    }
    </style>
